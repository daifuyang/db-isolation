# Build artifacts
bin/

# Go test caches
*.test
*.out

# Local config overrides
config/*.local.yaml
*.local.yaml

# Secrets — never commit
*.pem
*.key
.env
.env.*

# Logs
logs/*.log
logs/*.txt
!logs/.gitkeep

# Runtime directories (used by tests / smoke runs)
/var/lib/db-isolation/
/etc/db-isolation/

# Editor scratch
*.swp
.DS_Store

# DSH / OpenCode / session metadata — never commit
.dsh-meow/
.opencode/
docs/plan-*.md
docs/old-plan.md

# Database files
*.db
*.db-shm
*.db-wal

# Vendored / cache
vendor/
.gocache/
.gomod/